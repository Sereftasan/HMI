  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <!-- SAFETY NET: proven on site by PE analysis of the working build and by the
       0x80040154 (REGDB_E_CLASSNOTREG) crash - MX Component's ActUtlType COM
       server is registered in the 32-BIT view only, so this HMI must run as a
       32-bit process. Fail the build if that is ever switched off. -->
  <Target Name="KabanAssert32Bit" BeforeTargets="Build">
    <Error Condition="'$(PlatformTarget)' == 'x64' Or '$(Prefer32Bit)' != 'true'"
           Text="Kaban HMI must run 32-bit for MX Component COM. PlatformTarget='$(PlatformTarget)' Prefer32Bit='$(Prefer32Bit)'. Use Any CPU with 'Prefer 32-bit' CHECKED." />
  </Target>
  <!-- Shared profile drawings: one source in KabanHMI\Profiles, copied to
       bin\Debug\Profiles\ at build - add a DXF there and every machine has it. -->
  <Target Name="CopySharedProfiles" AfterTargets="Build">
    <ItemGroup>
      <SharedProfile Include="..\KabanHMI\Profiles\*.dxf" />
    </ItemGroup>
    <Copy SourceFiles="@(SharedProfile)" DestinationFolder="$(OutDir)Profiles\" SkipUnchangedFiles="true" />
  </Target>
